        double3 xformOp:translate = (0.087, 0, 0.0025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Components"
    {
        def Cube "IC_0"
        {
            color3f[] primvars:displayColor = [(0.08, 0.09, 0.1)]
            double size = 1
            float3 xformOp:scale = (0.03, 0.016, 0.006)
            double3 xformOp:translate = (0.015, -0.022, 0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "IC_1"
        {
            color3f[] primvars:displayColor = [(0.08, 0.09, 0.1)]
            double size = 1
            float3 xformOp:scale = (0.03, 0.016, 0.006)
            double3 xformOp:translate = (0.015, 0, 0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "IC_2"
        {
            color3f[] primvars:displayColor = [(0.08, 0.09, 0.1)]
            double size = 1
            float3 xformOp:scale = (0.03, 0.016, 0.006)
            double3 xformOp:translate = (0.015, 0.022, 0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
