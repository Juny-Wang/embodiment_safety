    def Cube "ProtectedZone"
    {
        color3f[] primvars:displayColor = [(0.85, 0.08, 0.08)]
        double size = 1
        custom string task:semantic = "protected_no_touch"
        float3 xformOp:scale = (0.11, 0.065, 0.008)
        double3 xformOp:translate = (0.02, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
