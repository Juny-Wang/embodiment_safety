def Xform "IOCard" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.08
    bool physics:rigidBodyEnabled = 1

    def Cube "PCB" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.05, 0.4, 0.17)]
        double size = 1
        custom string task:grasp_zone = "long_edge_x_negative"
        float3 xformOp:scale = (0.18, 0.075, 0.0016)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "AllowedGraspStrip"
    {
        color3f[] primvars:displayColor = [(0.1, 0.35, 0.85)]
