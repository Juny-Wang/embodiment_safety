over "World"
{
    over "RootStrainRelief"
    {
        over "Boot" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxSDFMeshCollisionAPI"]
        )
        {
            vector3f physics:angularVelocity = (0, 0, 0)
            uniform token physics:approximation = "sdf"
            bool physics:collisionEnabled = 1
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.004
            bool physics:rigidBodyEnabled = 1
            vector3f physics:velocity = (0, 0, 0)
            custom float physxCollision:contactOffset = 0.00015
            custom float physxCollision:restOffset = 0
            custom float physxRigidBody:angularDamping = 0.05
            custom float physxRigidBody:linearDamping = 0.05
