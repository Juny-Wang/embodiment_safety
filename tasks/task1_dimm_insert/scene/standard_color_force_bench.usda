#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 1000
    }

    def Material "TestMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.25
        float physics:restitution = 0
        float physics:staticFriction = 0.3
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/TestMaterial>
        double size = 0.01
        double3 xformOp:translate = (0, 0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
    )
    {
        rel material:binding:physics = </World/TestMaterial>
        float physics:mass = 0.02
        float physxContactReport:threshold = 0
        double size = 0.01
        double3 xformOp:translate = (0, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

