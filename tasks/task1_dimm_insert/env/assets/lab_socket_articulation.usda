        }
    }

    def "Joints"
    {
        def PhysicsFixedJoint "RootFixed"
        {
            rel physics:body1 = </Asset/Base>
            bool physics:jointEnabled = 1
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "LeftHinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.001
            float drive:angular:physics:maxForce = 0.02
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </Asset/Base>
            rel physics:body1 = </Asset/LeftLatch>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-0.07, 0, 0.003)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -40
            float physics:upperLimit = 0
        }

        def PhysicsRevoluteJoint "RightHinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.001
            float drive:angular:physics:maxForce = 0.02
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </Asset/Base>
            rel physics:body1 = </Asset/RightLatch>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0.07, 0, 0.003)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
