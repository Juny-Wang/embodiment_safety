#usda 1.0
(
    customLayerData = {
        string purpose = "Isaac Lab Articulation socket with Left/Right latch hinges"
        string base_collisions = "physics_proxy Base cubes (same as lab_socket_kinematic)"
        string hinge_source = "socket_franka_install_v008 (±40deg limits + hinge frames)"
        string note = "Asset = ArticulationRoot ONLY (no RigidBody). Base/LeftLatch/RightLatch are child rigid bodies. World pin via PhysicsFixedJoint RootFixed (NOT Lab fix_root_link — that moves ArticulationRoot onto env_0 and nests with Franka). Limits L -40..0, R 0..40 deg."
        string thresh1 = "joint_hard_stop=40deg; open_enough~15deg; closed_band~3deg"
    }
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]
    )
    {
        bool physics:kinematicEnabled = 0
        float physics:mass = 1.0
        float physxContactReport:threshold = 0
        bool physxRigidBody:disableGravity = 1
        bool physxRigidBody:enableCCD = 0
        int physxRigidBody:solverPositionIterationCount = 32
        int physxRigidBody:solverVelocityIterationCount = 4
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
